# ============================================
# CIB (Compliance in a Box) Configuration
# ============================================

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3003

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8431
VICTORIAMETRICS_RETENTION=90d

# ==================== Checker ====================
SCAN_INTERVAL_HOURS=6
SCAN_ON_STARTUP=true
TRIVY_TIMEOUT=300
# Extra images to check beyond running containers
# ADDITIONAL_IMAGES=nginx:latest,redis:7

# ==================== License Policy ====================
# Comma-separated SPDX license IDs to flag as violations
# Defaults to copyleft licenses (GPL, AGPL) — remove entries to relax policy
# LICENSE_DENY_LIST=GPL-2.0-only,GPL-2.0-or-later,GPL-3.0-only,GPL-3.0-or-later,AGPL-3.0-only,AGPL-3.0-or-later

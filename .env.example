# ============================================
# CIB (Compliance in a Box) Configuration
# ============================================

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3003

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8431
VICTORIAMETRICS_RETENTION=90d

# ==================== Checker ====================
SCAN_INTERVAL_HOURS=6
SCAN_ON_STARTUP=true
TRIVY_TIMEOUT=300
# Extra images to check beyond running containers
# ADDITIONAL_IMAGES=nginx:latest,redis:7

# ==================== Remote Docker (Optional) ====================
# Scan one or more remote Docker daemons (docker-socket-proxy recommended).
# DOCKER_HOSTS takes priority; falls back to DOCKER_HOST; falls back to local socket.
# When using only remote hosts, remove the /var/run/docker.sock volume from docker-compose.yml.
# A socket mount is root on the host (and `:ro` does not change that: it only makes the socket FILE read-only).
# Preferred: a read-only proxy that allows only GET /containers and /images. See the XIB umbrella's
# docker-compose.read-only-proxy.yml, or run tecnativa/docker-socket-proxy yourself with POST=0 EXEC=0 BUILD=0.
#
# Single remote host:
# DOCKER_HOST=tcp://203.0.113.212:2375
#
# Multiple remote hosts (name=url pairs, comma-separated):
# DOCKER_HOSTS=docker-vm=tcp://203.0.113.212:2375,dockerhost=tcp://203.0.113.25:2375
#
# All per-container/image metrics get a host="" label so you can filter in Grafana.

# ==================== License Policy ====================
# Pick a profile, or set your own list.
#   LICENSE_PROFILE=product   (default) flag any GPL/AGPL: for teams shipping proprietary software
#   LICENSE_PROFILE=internal  flag AGPL only: for running software on your own hardware, where GPL on
#                             OS base-image packages is normal (otherwise expect thousands of rows)
#   LICENSE_PROFILE=none      licence checks off; SBOM and EOL checks still run
LICENSE_PROFILE=product
# Comma-separated SPDX license IDs to flag as violations. Overrides the profile when set.
# LICENSE_DENY_LIST=GPL-2.0-only,GPL-2.0-or-later,GPL-3.0-only,GPL-3.0-or-later,AGPL-3.0-only,AGPL-3.0-or-later

# Network exposure (127.0.0.1 is safe for local demos; set 0.0.0.0 for LAN exposure)
BIND_ADDR=127.0.0.1

# ==================== Image tags ====================
# Pinned on purpose: `latest` moves under you (one tag used here has since disappeared upstream).
# Bump deliberately, then re-run the stack's smoke test.
GRAFANA_TAG=13.2.3
VICTORIAMETRICS_TAG=v1.153.0
